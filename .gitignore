# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# qec-drift data and results (regenerable; large); the reference tables are kept
data/*/*
!data/*/references.json
!data/audits/development-closeout-20261109.json
!data/audits/fresh-seed-closeout-20261110.json
results/
.cache/
*.npy
*.parquet
checkpoints/

# Serena's project index
.serena/

# scaffold trial episodes
trajectories/agent_trial/

# Generated paper previews; vector figures are versioned.
paper/workshop-20261111/figures/*.png

# mismatch track: its results folder is versioned (the `results/` rule above would hide it)
!mismatch/experiments/results/
mismatch/experiments/results/raw_hard/**/*.part
mismatch/experiments/results/shared_table.csv
mismatch/agent_kit/
mismatch/paper/
